<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="20dp">
        <TextView android:layout_width="36dp" android:layout_height="38dp" android:background="@drawable/button_primary" android:gravity="center" android:text="@string/brand_mark" style="@style/Display" android:textSize="28sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_name" style="@style/Display" android:textSize="26sp" android:includeFontPadding="false"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand_subtitle" android:textColor="@color/muted" android:textSize="8sp" android:letterSpacing="0.24"/>
        </LinearLayout>
        <ImageButton android:id="@+id/configurar" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/button_secondary" android:src="@drawable/ic_tune" android:contentDescription="@string/connect"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progresso" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:textColor="@color/muted" android:textSize="11sp" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:accessibilityLiveRegion="polite"/>
    <ScrollView android:id="@+id/conteudo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="264dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hero_burger" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hero_shade"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="22dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_eyebrow" style="@style/Eyebrow" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_title" style="@style/Display" android:textSize="40sp" android:lineSpacingExtra="-6sp" android:layout_marginTop="10dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_accent" style="@style/Display" android:textColor="@color/brand_light" android:textSize="27sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_copy" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="6dp"/>
                    <Button android:id="@+id/verCardapio" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hero_cta" android:layout_marginTop="14dp"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/menu_eyebrow" style="@style/Eyebrow" android:id="@+id/sobretitulo" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/menu_title" style="@style/Display" android:id="@+id/tituloPagina" android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/subtituloPagina" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
                <LinearLayout android:id="@+id/formulario" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel" android:padding="18dp" android:layout_marginBottom="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/form_eyebrow" style="@style/Eyebrow" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/form_title" style="@style/Display" android:id="@+id/tituloFormulario" android:layout_marginTop="6dp" android:layout_marginBottom="20dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/name_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/nome" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/name_hint" android:inputType="textCapSentences" android:maxLength="255"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/category_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/categoria" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/category_hint" android:inputType="textCapSentences" android:maxLength="255"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/price_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/valor" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/price_hint" android:inputType="numberDecimal"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/description_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/descricao" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/description_hint" android:inputType="textMultiLine" android:maxLength="255"/><CheckBox android:id="@+id/disponivel" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/available" android:textColor="@color/ink" android:textSize="13sp" android:checked="true"/><Button android:id="@+id/salvar" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" android:layout_marginTop="12dp"/><Button android:id="@+id/limpar" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear" android:layout_marginTop="8dp"/></LinearLayout>
                <EditText android:id="@+id/busca" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/search" android:inputType="text" android:singleLine="true"/>
                <HorizontalScrollView android:id="@+id/filtros" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="16dp"><LinearLayout android:id="@+id/categorias" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
                <Button android:id="@+id/atualizar" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refresh" android:layout_marginBottom="16dp"/>
                <LinearLayout android:id="@+id/itens" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/photos_note" android:id="@+id/notaFotos" android:textColor="@color/muted" android:textSize="10sp" android:gravity="center" android:layout_marginTop="12dp"/>
                <LinearLayout android:id="@+id/checkout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel" android:padding="18dp" android:layout_marginTop="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_eyebrow" style="@style/Eyebrow" /><TextView android:id="@+id/total" style="@style/Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="20dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/client_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/cliente" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/client_hint" android:inputType="textPersonName" android:maxLength="100"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/note_label" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginBottom="6dp"/><EditText android:id="@+id/observacao" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/note_hint" android:inputType="textMultiLine" android:maxLength="500"/><Button android:id="@+id/confirmar" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/confirm" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cart_hint" android:textSize="11sp" android:textColor="@color/muted" android:layout_marginTop="12dp"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/resumoCarrinho" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/summary" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:padding="6dp" android:orientation="horizontal"><Button android:id="@+id/cardapio" style="@style/NavItem" android:layout_width="0dp" android:layout_height="64dp" android:text="@string/nav_menu" android:layout_weight="1" android:drawableTop="@drawable/ic_menu"/><Button android:id="@+id/carrinho" style="@style/NavItem" android:layout_width="0dp" android:layout_height="64dp" android:text="@string/nav_cart" android:layout_weight="1" android:drawableTop="@drawable/ic_bag"/><Button android:id="@+id/pedidos" style="@style/NavItem" android:layout_width="0dp" android:layout_height="64dp" android:text="@string/nav_orders" android:layout_weight="1" android:drawableTop="@drawable/ic_receipt"/><Button android:id="@+id/gerenciar" style="@style/NavItem" android:layout_width="0dp" android:layout_height="64dp" android:text="@string/nav_manage" android:layout_weight="1" android:drawableTop="@drawable/ic_edit"/></LinearLayout>
</LinearLayout>
